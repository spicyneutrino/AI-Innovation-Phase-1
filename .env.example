# Copy to .env for local development (never commit .env).
# Streamlit Cloud: mirror these keys in .streamlit/secrets.toml (that file is gitignored).

# AWS credentials (omit when using an IAM role on EC2/Lambda/ECS)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# Amazon Bedrock Knowledge Base (required for the RAG assistant)
BEDROCK_KB_ID=your_knowledge_base_id

# Optional: override the default foundation model ARN
# BEDROCK_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-pro-v1:0

# Streamlit UI password gate
APP_PASSWORD=your_app_password

# Optional: crawler runtime directory (defaults to var/sos_crawler/)
# SOS_CRAWLER_RUNTIME_DIR=var/sos_crawler
